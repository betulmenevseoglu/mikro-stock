# --- Supabase Postgres -------------------------------------------------------
# Supabase panel > Project Settings > Database > Connection string
# DATABASE_URL  : "Transaction pooler" (port 6543) — uygulamanın kullandığı bağlantı
# DIRECT_URL    : "Direct connection"  (port 5432) — prisma migrate için
DATABASE_URL="postgresql://postgres.xxxxxxxx:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:SIFRE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (ürün resimleri) ---------------------------------------
# Supabase panel > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_STORAGE_BUCKET="urun-resimleri"

# --- Auth --------------------------------------------------------------------
# Üretmek için:  openssl rand -base64 32
AUTH_SECRET="buraya-rastgele-uzun-bir-metin"

# İlk yönetici kullanıcı (npm run db:seed ile oluşturulur)
SEED_ADMIN_EMAIL="admin@mikromuhendislik.com"
SEED_ADMIN_PASSWORD="degistir123"
SEED_ADMIN_NAME="Yönetici"
